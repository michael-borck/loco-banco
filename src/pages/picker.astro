---
import data from '../data/picker-data.json';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LocoBench Picker · GPU selection for AI inference</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3@7.8.5/dist/d3.min.js"></script>
  <style>
    :root {
      /* Background tones — warm navy, not pure black. Paper-under-lamp feel. */
      --bg-0: #0b0f14;
      --bg-1: #111822;
      --bg-2: #1a2230;
      --bg-3: #222c3d;

      /* Borders */
      --border-subtle: #1f2a38;
      --border: #2a3749;
      --border-strong: #3e5274;
      --border-bright: #556b8f;

      /* Foreground — warm paper */
      --fg-0: #e8e8e3;
      --fg-1: #c0c6d1;
      --fg-2: #8b94a3;
      --fg-3: #5a6373;
      --fg-4: #3d4654;

      /* Instrumentation accents */
      --amber: #ffb454;
      --amber-dim: #8a6430;
      --amber-glow: rgba(255, 180, 84, 0.12);
      --cyan: #66d9ef;
      --cyan-dim: #3b7b8a;
      --cyan-glow: rgba(102, 217, 239, 0.10);
      --green: #a6d76c;
      --green-glow: rgba(166, 215, 108, 0.10);
      --red: #f97583;

      /* Architecture colours */
      --arch-pascal: #5b8def;
      --arch-turing: #4bc3c3;
      --arch-ampere: #b695f7;
      --arch-ada: #66d9ef;
      --arch-blackwell: #f97583;
      --arch-server: #ffb454;

      /* Typography */
      --font-sans: 'IBM Plex Sans', -apple-system, sans-serif;
      --font-display: 'IBM Plex Sans Condensed', 'IBM Plex Sans', sans-serif;
      --font-mono: 'IBM Plex Mono', 'Menlo', 'Consolas', monospace;

      --shadow-plot: 0 0 0 1px var(--border-strong), 0 24px 60px -20px rgba(0, 0, 0, 0.6);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      background: var(--bg-0);
      color: var(--fg-0);
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(255, 180, 84, 0.04) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 100%, rgba(102, 217, 239, 0.03) 0%, transparent 50%),
        var(--bg-0);
      position: relative;
    }

    /* Subtle noise overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.35;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.05  0 0 0 0 0.05  0 0 0 0 0.05  0 0 0 0.5 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    }

    /* ============ HEADER ============ */

    .topbar {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 32px;
      border-bottom: 1px solid var(--border-subtle);
      background: rgba(11, 15, 20, 0.9);
      backdrop-filter: blur(8px);
    }

    .logo {
      display: flex;
      align-items: baseline;
      gap: 14px;
    }

    .logo-mark {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 18px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--fg-0);
    }

    .logo-mark .dot {
      color: var(--amber);
      margin: 0 6px;
    }

    .logo-sub {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-3);
      letter-spacing: 0.05em;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .currency-toggle {
      display: flex;
      border: 1px solid var(--border);
      border-radius: 2px;
      overflow: hidden;
      font-family: var(--font-mono);
      font-size: 12px;
    }

    .currency-toggle button {
      background: transparent;
      border: none;
      color: var(--fg-3);
      padding: 6px 14px;
      cursor: pointer;
      letter-spacing: 0.08em;
      font-family: inherit;
      font-size: inherit;
      transition: background 0.15s, color 0.15s;
    }

    .currency-toggle button:hover {
      color: var(--fg-1);
      background: var(--bg-2);
    }

    .currency-toggle button.active {
      background: var(--amber);
      color: var(--bg-0);
      font-weight: 500;
    }

    .version-tag {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-4);
      letter-spacing: 0.05em;
    }

    /* ============ FRAMING BANNER ============ */

    .framing {
      position: relative;
      z-index: 1;
      max-width: 1480px;
      margin: 0 auto;
      padding: 28px 32px 14px;
    }

    .framing-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 10px;
    }

    .framing-label::before,
    .framing-label::after {
      content: '';
      height: 1px;
      background: var(--amber-dim);
    }

    .framing-label::before { width: 12px; }
    .framing-label::after { flex: 1; max-width: 120px; opacity: 0.5; }

    .framing-title {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--fg-0);
      margin-bottom: 6px;
    }

    .framing-body {
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--fg-1);
      max-width: 780px;
      line-height: 1.6;
    }

    .framing-body .rule {
      font-family: var(--font-mono);
      color: var(--amber);
      font-size: 12px;
    }

    /* ============ CONTROL STRIP ============ */

    .controls {
      position: relative;
      z-index: 1;
      max-width: 1480px;
      margin: 0 auto;
      padding: 14px 32px 0;
    }

    .shortcut-row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      padding: 14px 18px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--bg-1);
      margin-bottom: 14px;
    }

    .shortcut-row .label {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--fg-3);
      margin-right: 4px;
    }

    .shortcut-row .phrase {
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--fg-1);
    }

    .inline-select {
      display: inline-block;
      background: var(--bg-2);
      border: 1px solid var(--border-strong);
      border-radius: 2px;
      color: var(--cyan);
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 500;
      padding: 4px 24px 4px 10px;
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 5 L6 8 L9 5' stroke='%2366d9ef' stroke-width='1.4' fill='none'/></svg>");
      background-repeat: no-repeat;
      background-position: right 6px center;
      background-size: 12px;
    }

    .inline-select:hover {
      border-color: var(--cyan-dim);
    }

    .axis-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .axis-control {
      border: 1px solid var(--border);
      background: var(--bg-1);
      padding: 12px 16px;
      border-radius: 3px;
    }

    .axis-control .label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--fg-3);
      margin-bottom: 6px;
    }

    .axis-control .label .axis-tag {
      color: var(--amber);
    }

    .axis-control select {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--fg-0);
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 500;
      padding: 2px 0;
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 5 L6 8 L9 5' stroke='%238b94a3' stroke-width='1.4' fill='none'/></svg>");
      background-repeat: no-repeat;
      background-position: right 2px center;
      background-size: 12px;
      padding-right: 20px;
    }

    .axis-control select:focus { outline: 1px solid var(--cyan-dim); outline-offset: 2px; }

    /* ============ MAIN LAYOUT ============ */

    .workspace {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 20px;
      max-width: 1480px;
      margin: 16px auto 0;
      padding: 0 32px;
    }

    /* ----- sidebar ----- */
    .sidebar {
      align-self: start;
      position: sticky;
      top: 16px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--bg-1);
      padding: 14px 16px;
    }

    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 10px;
      margin-bottom: 14px;
      border-bottom: 1px dashed var(--border);
    }

    .sidebar-title {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fg-1);
    }

    .sidebar-title::before {
      content: '[ ';
      color: var(--amber);
    }
    .sidebar-title::after {
      content: ' ]';
      color: var(--amber);
    }

    .visible-count {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-3);
    }

    .visible-count .n {
      color: var(--amber);
      font-weight: 600;
    }

    .filter-group {
      margin-bottom: 16px;
    }

    .filter-group:last-child { margin-bottom: 0; }

    .filter-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-2);
      margin-bottom: 6px;
      letter-spacing: 0.05em;
    }

    .filter-label .readout {
      color: var(--amber);
      font-weight: 500;
    }

    .filter-group select,
    .filter-group input[type="range"] {
      width: 100%;
    }

    .filter-group select {
      background: var(--bg-2);
      border: 1px solid var(--border);
      color: var(--fg-0);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 5px 22px 5px 8px;
      border-radius: 2px;
      appearance: none;
      cursor: pointer;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 5 L6 8 L9 5' stroke='%238b94a3' stroke-width='1.4' fill='none'/></svg>");
      background-repeat: no-repeat;
      background-position: right 6px center;
      background-size: 12px;
    }

    /* Custom range slider */
    input[type="range"] {
      appearance: none;
      height: 4px;
      background: var(--bg-3);
      border-radius: 2px;
      outline: none;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-thumb {
      appearance: none;
      width: 14px;
      height: 14px;
      background: var(--amber);
      border: 2px solid var(--bg-0);
      border-radius: 50%;
      cursor: pointer;
      box-shadow: 0 0 0 1px var(--amber);
    }

    input[type="range"]::-moz-range-thumb {
      width: 14px;
      height: 14px;
      background: var(--amber);
      border: 2px solid var(--bg-0);
      border-radius: 50%;
      cursor: pointer;
      box-shadow: 0 0 0 1px var(--amber);
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--fg-1);
      padding: 4px 0;
    }

    .checkbox-row input[type="checkbox"] {
      appearance: none;
      width: 14px;
      height: 14px;
      border: 1px solid var(--border-strong);
      background: var(--bg-2);
      border-radius: 2px;
      cursor: pointer;
      position: relative;
    }

    .checkbox-row input[type="checkbox"]:checked {
      background: var(--amber);
      border-color: var(--amber);
    }

    .checkbox-row input[type="checkbox"]:checked::after {
      content: '';
      position: absolute;
      left: 3px;
      top: 0;
      width: 4px;
      height: 8px;
      border: solid var(--bg-0);
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }

    .radio-group {
      display: flex;
      gap: 2px;
      border: 1px solid var(--border);
      border-radius: 2px;
      overflow: hidden;
    }

    .radio-group label {
      flex: 1;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11px;
      padding: 5px 6px;
      cursor: pointer;
      color: var(--fg-2);
      background: var(--bg-2);
      transition: background 0.15s, color 0.15s;
      letter-spacing: 0.04em;
    }

    .radio-group label:hover {
      color: var(--fg-0);
    }

    .radio-group input[type="radio"] {
      display: none;
    }

    .radio-group input[type="radio"]:checked + label {
      background: var(--amber);
      color: var(--bg-0);
      font-weight: 500;
    }

    /* ----- plot area ----- */
    .plot-zone {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .plot-frame {
      border: 1px solid var(--border-strong);
      background: var(--bg-1);
      border-radius: 3px;
      position: relative;
      box-shadow: var(--shadow-plot);
    }

    .plot-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-2);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-2);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .plot-header .left {
      display: flex;
      gap: 24px;
      align-items: baseline;
    }

    .plot-header .channel {
      display: inline-flex;
      gap: 6px;
      align-items: center;
    }

    .plot-header .channel::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 4px;
      background: var(--amber);
      border-radius: 50%;
      animation: pulse 1.6s ease-in-out infinite;
    }

    .plot-header .channel.idle::before {
      background: var(--fg-4);
      animation: none;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 4px var(--amber); }
      50% { opacity: 0.3; box-shadow: none; }
    }

    .plot-header .right {
      font-size: 10px;
      color: var(--fg-3);
    }

    #plot {
      width: 100%;
      height: 560px;
      display: block;
    }

    /* SVG text styling */
    svg text {
      font-family: var(--font-mono);
      font-size: 11px;
      fill: var(--fg-2);
    }

    svg .axis-title {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      fill: var(--fg-2);
      font-weight: 500;
    }

    svg .grid line {
      stroke: var(--border);
      stroke-dasharray: 2, 3;
    }
    svg .grid .domain { stroke: none; }

    svg .axis line,
    svg .axis path.domain {
      stroke: var(--border-strong);
    }

    svg .axis text {
      fill: var(--fg-2);
    }

    svg .pareto-line {
      fill: none;
      stroke: var(--amber);
      stroke-width: 1.5;
      stroke-dasharray: none;
      opacity: 0.8;
    }

    svg .pareto-area {
      fill: url(#paretoGradient);
      opacity: 0.12;
    }

    svg .guide-line {
      stroke: var(--cyan);
      stroke-width: 1;
      stroke-dasharray: 4, 4;
      opacity: 0.6;
    }

    svg .crosshair-line {
      stroke: var(--fg-3);
      stroke-width: 0.8;
      stroke-dasharray: 2, 3;
      opacity: 0.6;
      pointer-events: none;
    }

    .dot {
      cursor: pointer;
      transition: r 0.15s;
    }

    .dot:hover {
      filter: drop-shadow(0 0 8px currentColor);
    }

    .dot.pareto {
      stroke-width: 2;
    }

    .dot.selected {
      stroke-width: 3;
      filter: drop-shadow(0 0 10px var(--amber));
    }

    /* ----- legend + callout ----- */
    .sub-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .panel {
      border: 1px solid var(--border);
      background: var(--bg-1);
      border-radius: 3px;
      padding: 12px 16px;
    }

    .panel-header {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fg-1);
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--border);
    }

    .panel-header::before {
      content: '[ ';
      color: var(--cyan);
    }
    .panel-header::after {
      content: ' ]';
      color: var(--cyan);
    }

    .legend {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .legend-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 18px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-1);
    }

    .legend-swatch {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: currentColor;
    }

    .legend-swatch.outline {
      background: transparent;
      border: 1.4px dashed currentColor;
    }

    .legend-sub {
      margin-top: 6px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--fg-3);
      letter-spacing: 0.04em;
    }

    .callout-rule {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-1);
      padding: 3px 0;
    }

    .callout-rule .op {
      color: var(--amber);
    }
    .callout-rule .eq {
      color: var(--fg-3);
    }

    /* ----- tooltip ----- */
    .tooltip {
      position: absolute;
      pointer-events: none;
      background: rgba(11, 15, 20, 0.97);
      border: 1px solid var(--border-bright);
      border-radius: 3px;
      padding: 10px 14px;
      min-width: 220px;
      font-family: var(--font-sans);
      font-size: 12px;
      color: var(--fg-0);
      opacity: 0;
      transition: opacity 0.12s;
      z-index: 100;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
    }

    .tooltip.visible { opacity: 1; }

    .tooltip .tt-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.02em;
      margin-bottom: 4px;
      color: var(--fg-0);
    }

    .tooltip .tt-arch {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .tooltip .tt-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 3px 14px;
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .tooltip .tt-grid dt {
      color: var(--fg-3);
    }

    .tooltip .tt-grid dd {
      color: var(--fg-0);
      text-align: right;
    }

    .tooltip .tt-grid dd.amber { color: var(--amber); font-weight: 500; }

    .tooltip .tt-tag {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 9px;
      padding: 2px 6px;
      border-radius: 2px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-top: 8px;
    }

    .tt-tag.measured { background: var(--green-glow); color: var(--green); border: 1px solid rgba(166, 215, 108, 0.3); }
    .tt-tag.estimated { background: var(--amber-glow); color: var(--amber); border: 1px dashed rgba(255, 180, 84, 0.45); }
    .tt-tag.community { background: var(--cyan-glow); color: var(--cyan); border: 1px solid rgba(102, 217, 239, 0.3); }

    /* ============ DETAIL PANEL ============ */

    .detail {
      max-width: 1480px;
      margin: 20px auto 60px;
      padding: 0 32px;
      display: none;
    }

    .detail.visible {
      display: block;
      animation: slideUp 0.3s ease-out;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .detail-frame {
      border: 1px solid var(--border-strong);
      background: var(--bg-1);
      border-radius: 3px;
      position: relative;
    }

    .detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 18px 22px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-2);
    }

    .detail-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--fg-0);
    }

    .detail-meta {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-3);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .detail-close {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--fg-2);
      padding: 6px 12px;
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      border-radius: 2px;
    }

    .detail-close:hover {
      border-color: var(--amber);
      color: var(--amber);
    }

    .detail-body {
      padding: 22px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 26px;
    }

    .detail-specs dl {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 6px 22px;
      font-family: var(--font-mono);
      font-size: 12px;
    }

    .detail-specs dt {
      color: var(--fg-3);
      letter-spacing: 0.04em;
    }

    .detail-specs dd {
      color: var(--fg-0);
      text-align: right;
    }

    .detail-specs dd.amber { color: var(--amber); font-weight: 500; }

    .detail-results table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--font-mono);
      font-size: 12px;
    }

    .detail-results th {
      text-align: left;
      padding: 4px 6px;
      font-weight: 500;
      color: var(--fg-3);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px dashed var(--border);
    }

    .detail-results th:last-child { text-align: right; }

    .detail-results td {
      padding: 6px 6px;
      color: var(--fg-0);
      border-bottom: 1px dashed var(--border-subtle);
    }

    .detail-results td.value {
      text-align: right;
      color: var(--amber);
      font-weight: 500;
    }

    .detail-results td.value.estimated {
      color: var(--amber);
      font-style: italic;
    }

    .detail-results td.value.na {
      color: var(--fg-4);
      font-style: italic;
      font-weight: normal;
    }

    .detail-notes {
      grid-column: 1 / -1;
      padding-top: 18px;
      border-top: 1px dashed var(--border);
      font-family: var(--font-sans);
      font-size: 13px;
      color: var(--fg-1);
      line-height: 1.6;
    }

    .detail-notes::before {
      content: 'NOTES // ';
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--amber);
      letter-spacing: 0.12em;
    }

    /* ============ FOOTER ============ */

    .footer {
      max-width: 1480px;
      margin: 40px auto 30px;
      padding: 20px 32px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--fg-4);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .footer a {
      color: var(--fg-3);
      text-decoration: none;
      border-bottom: 1px dashed var(--fg-4);
    }

    .footer a:hover { color: var(--amber); border-bottom-color: var(--amber); }

    /* ============ RESPONSIVE ============ */

    @media (max-width: 1100px) {
      .workspace {
        grid-template-columns: 1fr;
      }
      .sidebar {
        position: static;
      }
      .detail-body, .sub-row {
        grid-template-columns: 1fr;
      }
      .axis-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

<!-- ============================================================== -->
<!-- TOP BAR                                                          -->
<!-- ============================================================== -->
<header class="topbar">
  <div class="logo">
    <span class="logo-mark">LocoBench<span class="dot">::</span>Picker</span>
    <span class="logo-sub">GPU selection for AI inference</span>
  </div>
  <div class="topbar-right">
    <div class="currency-toggle" role="group" aria-label="Currency selection">
      <button id="ccy-aud" class="active" data-ccy="aud">AUD</button>
      <button id="ccy-usd" data-ccy="usd">USD</button>
    </div>
    <span class="version-tag">v0.1 · prototype · placeholder data</span>
  </div>
</header>

<!-- ============================================================== -->
<!-- FRAMING BANNER — "what a LocoBench number means"                 -->
<!-- ============================================================== -->
<section class="framing">
  <div class="framing-label">What a LocoBench number means</div>
  <div class="framing-title">Each measurement is a tier <em>floor</em>, not a ranking.</div>
  <div class="framing-body">
    If your card has at least this VRAM and at least this bandwidth, in the same or newer architecture, you will match or beat the result below. &nbsp;
    <span class="rule">same specs &rarr; same number</span>. &nbsp;
    <span class="rule">newer architecture at same specs &rarr; better</span>. &nbsp;
    <span class="rule">more of any spec &rarr; better</span>.
  </div>
</section>

<!-- ============================================================== -->
<!-- CONTROL STRIP — model shortcut + axis selection                  -->
<!-- ============================================================== -->
<div class="controls">
  <div class="shortcut-row">
    <span class="label">Quick config</span>
    <span class="phrase">
      I want to run
      <select id="shortcut-size" class="inline-select">
        <option value="">(choose size)</option>
        <option value="7B">7B</option>
        <option value="13B">13B</option>
        <option value="30B">30B</option>
      </select>
      at
      <select id="shortcut-quant" class="inline-select">
        <option value="Q4_K_M">Q4_K_M</option>
        <option value="Q8_0">Q8_0</option>
        <option value="FP16">FP16</option>
      </select>
    </span>
    <span style="flex:1"></span>
    <button id="shortcut-apply" class="inline-select" style="color: var(--amber); cursor: pointer; font-weight: 500; background-image: none; padding: 5px 12px;">APPLY →</button>
    <button id="shortcut-reset" class="inline-select" style="color: var(--fg-3); cursor: pointer; background-image: none; padding: 5px 12px;">RESET</button>
  </div>

  <div class="axis-row">
    <div class="axis-control">
      <div class="label">X axis <span class="axis-tag">→</span></div>
      <select id="x-axis">
        <option value="cost_bracket">Cost bracket</option>
        <option value="vram_gb">VRAM (GB)</option>
        <option value="bandwidth_gb_s">Bandwidth (GB/s)</option>
        <option value="power_draw_w">Power draw (W)</option>
        <option value="release_year">Release year</option>
        <option value="cc">Compute capability</option>
      </select>
    </div>
    <div class="axis-control">
      <div class="label">Y axis <span class="axis-tag">↑</span></div>
      <select id="y-axis">
        <option value="benchmark">Benchmark metric</option>
        <option value="vram_gb">VRAM (GB)</option>
        <option value="bandwidth_gb_s">Bandwidth (GB/s)</option>
        <option value="power_draw_w">Power draw (W)</option>
      </select>
    </div>
    <div class="axis-control">
      <div class="label">Benchmark <span class="axis-tag">•</span></div>
      <select id="benchmark">
        <!-- populated from data -->
      </select>
    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- WORKSPACE: filters + plot                                        -->
<!-- ============================================================== -->
<div class="workspace">
  <aside class="sidebar">
    <div class="sidebar-header">
      <span class="sidebar-title">Filters</span>
      <span class="visible-count"><span class="n" id="visible-n">0</span> / <span id="total-n">0</span></span>
    </div>

    <div class="filter-group">
      <div class="filter-label">
        <span>Min VRAM</span>
        <span class="readout" id="readout-vram">0 GB</span>
      </div>
      <input type="range" id="f-min-vram" min="0" max="32" step="2" value="0">
    </div>

    <div class="filter-group">
      <div class="filter-label">
        <span>Compute capability</span>
        <span class="readout" id="readout-cc">maxwell+</span>
      </div>
      <select id="f-min-cc">
        <option value="5.0">Maxwell+ (CC 5.0): LocoBench floor</option>
        <option value="6.0">Pascal+ (CC 6.0): full modern stack</option>
        <option value="7.5">Turing+ (CC 7.5): Tensor Cores</option>
        <option value="8.6">Ampere+ (CC 8.6)</option>
        <option value="8.9">Ada+ (CC 8.9)</option>
        <option value="10.0">Blackwell+ (CC 10.0)</option>
      </select>
    </div>

    <div class="filter-group">
      <div class="filter-label">
        <span>Tensor Cores</span>
        <span class="readout" id="readout-tc">any</span>
      </div>
      <div class="radio-group">
        <input type="radio" name="tc" id="tc-any" value="any" checked><label for="tc-any">ANY</label>
        <input type="radio" name="tc" id="tc-yes" value="yes"><label for="tc-yes">YES</label>
        <input type="radio" name="tc" id="tc-no" value="no"><label for="tc-no">NO</label>
      </div>
    </div>

    <div class="filter-group">
      <div class="filter-label">
        <span>Max cost</span>
        <span class="readout" id="readout-cost">$$$$$</span>
      </div>
      <input type="range" id="f-max-cost" min="1" max="5" step="1" value="5">
    </div>

    <div class="filter-group">
      <div class="filter-label">
        <span>Class</span>
      </div>
      <div class="radio-group">
        <input type="radio" name="class" id="cls-both" value="both" checked><label for="cls-both">BOTH</label>
        <input type="radio" name="class" id="cls-consumer" value="consumer"><label for="cls-consumer">CONS</label>
        <input type="radio" name="class" id="cls-server" value="server"><label for="cls-server">SRV</label>
      </div>
    </div>

    <div class="filter-group">
      <label class="checkbox-row">
        <input type="checkbox" id="f-show-est" checked>
        Show estimated data
      </label>
      <label class="checkbox-row">
        <input type="checkbox" id="f-show-pareto" checked>
        Draw Pareto frontier
      </label>
    </div>
  </aside>

  <main class="plot-zone">
    <div class="plot-frame">
      <div class="plot-header">
        <div class="left">
          <span class="channel" id="channel-status">READOUT · LIVE</span>
          <span id="channel-meta">·</span>
        </div>
        <div class="right">Click a dot for details, hover for a tooltip.</div>
      </div>
      <svg id="plot"></svg>
      <div class="tooltip" id="tooltip"></div>
    </div>

    <div class="sub-row">
      <div class="panel">
        <div class="panel-header">Legend</div>
        <div class="legend">
          <div class="legend-group" id="legend-arch"></div>
          <div class="legend-sub">Architecture family (colour)</div>
          <div class="legend-group" style="margin-top: 8px;">
            <div class="legend-item" style="color: var(--fg-1);">
              <span class="legend-swatch"></span> measured (solid)
            </div>
            <div class="legend-item" style="color: var(--fg-1);">
              <span class="legend-swatch outline"></span> estimated (dashed)
            </div>
            <div class="legend-item" style="color: var(--amber);">
              <span class="legend-swatch" style="border-radius: 0; width: 12px; height: 2px;"></span> Pareto frontier
            </div>
          </div>
          <div class="legend-sub">Confidence and frontier</div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">Interpretation key</div>
        <div class="callout-rule"><span class="eq">Same VRAM + same bandwidth</span> <span class="op">=</span> same result expected</div>
        <div class="callout-rule"><span class="eq">Same VRAM, newer arch</span> <span class="op">&gt;</span> better</div>
        <div class="callout-rule"><span class="eq">Same arch, more bandwidth</span> <span class="op">&gt;</span> better</div>
        <div class="callout-rule"><span class="eq">More VRAM</span> <span class="op">⇒</span> unlocks bigger models (different tier)</div>
        <div class="legend-sub" style="margin-top: 10px;">
          The floor includes CC 5.2 Maxwell cards. A 2 GB card runs TinyLlama, 4 GB runs Phi-3 Mini, and 6 GB runs 7B Q4. You do not need a 24 GB rig to take part.
        </div>
        <div class="legend-sub" style="margin-top: 6px;">
          Secondhand tiers ($ and $$) require patience because supply is thin and pricing is erratic. Prices exclude postage.
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ============================================================== -->
<!-- DETAIL PANEL — shown when a card is clicked                      -->
<!-- ============================================================== -->
<section class="detail" id="detail">
  <div class="detail-frame">
    <header class="detail-header">
      <div>
        <h2 class="detail-title" id="detail-title">—</h2>
        <div class="detail-meta" id="detail-meta">—</div>
      </div>
      <button class="detail-close" id="detail-close">CLOSE [ × ]</button>
    </header>
    <div class="detail-body">
      <div class="detail-specs">
        <div class="panel-header" style="margin-bottom: 14px; border-bottom-style: solid;">Specifications</div>
        <dl id="detail-specs-list"></dl>
      </div>
      <div class="detail-results">
        <div class="panel-header" style="margin-bottom: 14px; border-bottom-style: solid;">Benchmark results</div>
        <table id="detail-results-table">
          <thead>
            <tr>
              <th>Benchmark</th>
              <th>Confidence</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="detail-notes" id="detail-notes"></div>
    </div>
  </div>
</section>

<!-- ============================================================== -->
<!-- FOOTER                                                           -->
<!-- ============================================================== -->
<footer class="footer">
  <div>LocoLabo · Independent Research Lab · Perth</div>
  <div>schema v0.1 · <a href="https://github.com/michael-borck/loco-banco/blob/main/src/data/picker-data.json" target="_blank">picker-data.json</a></div>
</footer>

<script is:inline type="application/json" id="embedded-picker-data" set:html={JSON.stringify(data)}></script>

<script is:inline>
// ====================================================================
// STATE + CONSTANTS
// ====================================================================

const state = {
  data: null,
  currency: (localStorage.getItem('picker-currency') || 'aud'),
  xAxis: 'cost_bracket',
  yAxis: 'benchmark',
  benchmark: null,
  filters: {
    minVram: 0,
    minCc: 5.0,       // LocoBench floor — Maxwell inclusive
    tensorCores: 'any',
    maxCost: 5,
    classFilter: 'both',
    showEstimated: true,
    showPareto: true,
  },
  selectedGpu: null,
};

// Direction of "better" per axis — drives the Pareto frontier.
const AXIS_BETTER = {
  cost_bracket: 'min',
  vram_gb: 'max',
  bandwidth_gb_s: 'max',
  power_draw_w: 'min',
  release_year: 'max',
  cc: 'max',
  benchmark: 'max',     // driven by benchmark.higher_is_better
};

const AXIS_LABELS = {
  cost_bracket: 'Cost bracket',
  vram_gb: 'VRAM (GB)',
  bandwidth_gb_s: 'Bandwidth (GB/s)',
  power_draw_w: 'Power draw (W)',
  release_year: 'Release year',
  cc: 'Compute capability',
};

const AXIS_UNITS = {
  vram_gb: 'GB',
  bandwidth_gb_s: 'GB/s',
  power_draw_w: 'W',
  release_year: '',
  cc: '',
};

const CONFIDENCE_LABELS = {
  measured: 'MEASURED',
  community: 'COMMUNITY',
  estimated: 'ESTIMATED',
};

// ====================================================================
// LOAD DATA
// ====================================================================

async function init() {
  const embedded = document.getElementById('embedded-picker-data');
  state.data = JSON.parse(embedded.textContent);
  state.benchmark = state.data.benchmarks[0].id;

  wireUI();
  populateBenchmarkDropdown();
  populateLegend();
  render();
}

init();

// ====================================================================
// CURRENCY
// ====================================================================

function formatCostBracket(code, ccyCode) {
  const bracket = state.data.cost_brackets.find(b => b.code === code);
  if (!bracket) return code;
  const ccy = state.data.currencies[ccyCode];
  const mult = ccy.from_usd;
  const low = Math.round(bracket.usd_low * mult);
  const high = bracket.usd_high == null ? null : Math.round(bracket.usd_high * mult);
  const range = high == null ? `${low}+` : `${low}–${high}`;
  return `${code}  ${ccy.symbol}${range} ${ccy.code}`;
}

function bracketTickLabel(code) {
  return formatCostBracket(code, state.currency);
}

// ====================================================================
// WIRE UP UI EVENTS
// ====================================================================

function wireUI() {
  document.querySelectorAll('.currency-toggle button').forEach(btn => {
    btn.addEventListener('click', () => {
      const ccy = btn.dataset.ccy;
      if (ccy === state.currency) return;
      state.currency = ccy;
      localStorage.setItem('picker-currency', ccy);
      document.querySelectorAll('.currency-toggle button').forEach(b => b.classList.toggle('active', b.dataset.ccy === ccy));
      render();
    });
    btn.classList.toggle('active', btn.dataset.ccy === state.currency);
  });

  document.getElementById('x-axis').value = state.xAxis;
  document.getElementById('x-axis').addEventListener('change', e => { state.xAxis = e.target.value; render(); });

  document.getElementById('y-axis').value = state.yAxis;
  document.getElementById('y-axis').addEventListener('change', e => { state.yAxis = e.target.value; render(); });

  document.getElementById('benchmark').addEventListener('change', e => { state.benchmark = e.target.value; render(); });

  document.getElementById('f-min-vram').addEventListener('input', e => {
    state.filters.minVram = +e.target.value;
    document.getElementById('readout-vram').textContent = `${e.target.value} GB`;
    render();
  });

  document.getElementById('f-min-cc').addEventListener('change', e => {
    state.filters.minCc = parseFloat(e.target.value) || 0;
    const lbl = e.target.options[e.target.selectedIndex].text;
    document.getElementById('readout-cc').textContent = lbl.replace(/\s*\(.*\)/, '').toLowerCase();
    render();
  });

  document.querySelectorAll('input[name="tc"]').forEach(inp => {
    inp.addEventListener('change', () => {
      state.filters.tensorCores = document.querySelector('input[name="tc"]:checked').value;
      document.getElementById('readout-tc').textContent = state.filters.tensorCores;
      render();
    });
  });

  document.getElementById('f-max-cost').addEventListener('input', e => {
    state.filters.maxCost = +e.target.value;
    document.getElementById('readout-cost').textContent = '$'.repeat(+e.target.value);
    render();
  });

  document.querySelectorAll('input[name="class"]').forEach(inp => {
    inp.addEventListener('change', () => {
      state.filters.classFilter = document.querySelector('input[name="class"]:checked').value;
      render();
    });
  });

  document.getElementById('f-show-est').addEventListener('change', e => {
    state.filters.showEstimated = e.target.checked;
    render();
  });

  document.getElementById('f-show-pareto').addEventListener('change', e => {
    state.filters.showPareto = e.target.checked;
    render();
  });

  document.getElementById('shortcut-apply').addEventListener('click', () => applyShortcut());
  document.getElementById('shortcut-reset').addEventListener('click', () => resetFilters());

  document.getElementById('detail-close').addEventListener('click', () => {
    state.selectedGpu = null;
    document.getElementById('detail').classList.remove('visible');
    render();
  });

  // initial readout labels
  document.getElementById('readout-cost').textContent = '$'.repeat(state.filters.maxCost);
  document.getElementById('readout-cc').textContent = 'maxwell+';
  document.getElementById('f-min-cc').value = String(state.filters.minCc);
}

function populateBenchmarkDropdown() {
  const sel = document.getElementById('benchmark');
  sel.innerHTML = '';
  state.data.benchmarks.forEach(b => {
    const opt = document.createElement('option');
    opt.value = b.id;
    opt.textContent = b.display_name;
    sel.appendChild(opt);
  });
  sel.value = state.benchmark;
}

function populateLegend() {
  const el = document.getElementById('legend-arch');
  el.innerHTML = '';
  const groups = [
    { key: 'pascal_consumer', label: 'Pascal (consumer)' },
    { key: 'turing_consumer', label: 'Turing' },
    { key: 'ampere_consumer', label: 'Ampere' },
    { key: 'ada_consumer', label: 'Ada Lovelace' },
    { key: 'blackwell_consumer', label: 'Blackwell' },
    { key: 'server', label: 'Server / DC' },
  ];
  groups.forEach(g => {
    const color = state.data.architecture_colors[g.key];
    const d = document.createElement('div');
    d.className = 'legend-item';
    d.style.color = color;
    d.innerHTML = `<span class="legend-swatch"></span><span style="color: var(--fg-1)">${g.label}</span>`;
    el.appendChild(d);
  });
}

function applyShortcut() {
  const size = document.getElementById('shortcut-size').value;
  const quant = document.getElementById('shortcut-quant').value;
  if (!size) return;

  const shortcut = state.data.model_shortcuts[size]?.[quant];
  if (!shortcut) return;

  // Set min VRAM
  state.filters.minVram = shortcut.vram_required_gb;
  const slider = document.getElementById('f-min-vram');
  slider.value = shortcut.vram_required_gb;
  document.getElementById('readout-vram').textContent = `${shortcut.vram_required_gb} GB`;

  // Set Y axis to benchmark, switch benchmark
  state.yAxis = 'benchmark';
  document.getElementById('y-axis').value = 'benchmark';

  if (shortcut.matching_benchmark) {
    state.benchmark = shortcut.matching_benchmark;
    document.getElementById('benchmark').value = shortcut.matching_benchmark;
  }

  // Set X to cost by default for the shortcut
  state.xAxis = 'cost_bracket';
  document.getElementById('x-axis').value = 'cost_bracket';

  render();
}

function resetFilters() {
  state.filters = { minVram: 0, minCc: 5.0, tensorCores: 'any', maxCost: 5, classFilter: 'both', showEstimated: true, showPareto: true };
  document.getElementById('f-min-vram').value = 0;
  document.getElementById('readout-vram').textContent = '0 GB';
  document.getElementById('f-min-cc').value = 5.0;
  document.getElementById('readout-cc').textContent = 'maxwell+';
  document.querySelector('input[name="tc"][value="any"]').checked = true;
  document.getElementById('readout-tc').textContent = 'any';
  document.getElementById('f-max-cost').value = 5;
  document.getElementById('readout-cost').textContent = '$$$$$';
  document.querySelector('input[name="class"][value="both"]').checked = true;
  document.getElementById('f-show-est').checked = true;
  document.getElementById('f-show-pareto').checked = true;
  document.getElementById('shortcut-size').value = '';
  render();
}

// ====================================================================
// FILTERING
// ====================================================================

function costBracketRank(code) {
  return code.length;  // "$" = 1, "$$" = 2, ..., "$$$$$" = 5
}

function passesFilters(gpu) {
  if (gpu.vram_gb < state.filters.minVram) return false;
  if (gpu.cc < state.filters.minCc) return false;
  if (state.filters.tensorCores === 'yes' && !gpu.tensor_cores.present) return false;
  if (state.filters.tensorCores === 'no' && gpu.tensor_cores.present) return false;
  if (costBracketRank(gpu.cost_bracket) > state.filters.maxCost) return false;
  if (state.filters.classFilter !== 'both' && gpu.class !== state.filters.classFilter) return false;
  return true;
}

function getAxisValue(gpu, axis) {
  if (axis === 'benchmark') {
    const r = gpu.results?.[state.benchmark];
    return r?.value;
  }
  if (axis === 'cost_bracket') {
    return costBracketRank(gpu.cost_bracket);
  }
  if (axis === 'vram_gb') return gpu.vram_gb;
  if (axis === 'bandwidth_gb_s') return gpu.memory.bandwidth_gb_s;
  if (axis === 'power_draw_w') return gpu.power_draw_w;
  if (axis === 'release_year') return gpu.release_year;
  if (axis === 'cc') return gpu.cc;
  return null;
}

function getConfidence(gpu) {
  // Worst-case confidence across the two axes used
  const confidences = [];
  if (state.yAxis === 'benchmark') {
    const r = gpu.results?.[state.benchmark];
    if (r?.confidence) confidences.push(r.confidence);
  }
  // X-axis values are from specs → treat as measured unless benchmark-dependent
  if (state.xAxis === 'benchmark') {
    const r = gpu.results?.[state.benchmark];
    if (r?.confidence) confidences.push(r.confidence);
  }
  if (confidences.includes('estimated')) return 'estimated';
  if (confidences.includes('community')) return 'community';
  return 'measured';
}

function archColor(gpu) {
  if (gpu.class === 'server') return state.data.architecture_colors.server;
  const key = `${gpu.architecture}_consumer`;
  return state.data.architecture_colors[key] || '#888';
}

// ====================================================================
// PARETO FRONTIER
// ====================================================================

function computePareto(points, xDir, yDir) {
  // Points already have { x, y }; return subset not dominated.
  const pts = points.filter(p => p.x != null && p.y != null && Number.isFinite(p.x) && Number.isFinite(p.y));

  const frontier = pts.filter(p => {
    return !pts.some(q => {
      if (p === q) return false;
      const xBetterOrEqual = xDir === 'max' ? q.x >= p.x : q.x <= p.x;
      const yBetterOrEqual = yDir === 'max' ? q.y >= p.y : q.y <= p.y;
      const xStrictly = xDir === 'max' ? q.x > p.x : q.x < p.x;
      const yStrictly = yDir === 'max' ? q.y > p.y : q.y < p.y;
      return xBetterOrEqual && yBetterOrEqual && (xStrictly || yStrictly);
    });
  });

  // Sort by x (ascending) for drawing a line
  frontier.sort((a, b) => a.x - b.x);
  return frontier;
}

// ====================================================================
// RENDER
// ====================================================================

function render() {
  const gpus = state.data.gpus.filter(passesFilters);

  // Extract (x, y, gpu) points; drop any with undefined values
  const points = gpus.map(gpu => {
    const confidence = getConfidence(gpu);
    if (confidence === 'estimated' && !state.filters.showEstimated) return null;
    const x = getAxisValue(gpu, state.xAxis);
    const y = getAxisValue(gpu, state.yAxis);
    if (x == null || y == null || !Number.isFinite(x) || !Number.isFinite(y)) return null;
    return { x, y, gpu, confidence };
  }).filter(Boolean);

  // Counts
  document.getElementById('visible-n').textContent = points.length;
  document.getElementById('total-n').textContent = state.data.gpus.length;

  // Channel meta
  const xLabel = state.xAxis === 'cost_bracket'
    ? 'COST'
    : AXIS_LABELS[state.xAxis].toUpperCase();
  const yLabel = state.yAxis === 'benchmark'
    ? state.data.benchmarks.find(b => b.id === state.benchmark)?.short_name?.toUpperCase() || 'BENCH'
    : AXIS_LABELS[state.yAxis].toUpperCase();
  document.getElementById('channel-meta').textContent = `${xLabel}  ×  ${yLabel}`;

  // Pareto
  const xDir = AXIS_BETTER[state.xAxis] || 'max';
  let yDir = AXIS_BETTER[state.yAxis] || 'max';
  if (state.yAxis === 'benchmark') {
    const b = state.data.benchmarks.find(bb => bb.id === state.benchmark);
    yDir = b?.higher_is_better ? 'max' : 'min';
  }
  const paretoSet = state.filters.showPareto ? computePareto(points, xDir, yDir) : [];
  const paretoIds = new Set(paretoSet.map(p => p.gpu.id));

  drawPlot(points, paretoSet, paretoIds, xDir, yDir);
}

// ====================================================================
// D3 PLOT
// ====================================================================

function drawPlot(points, paretoPoints, paretoIds, xDir, yDir) {
  const svg = d3.select('#plot');
  svg.selectAll('*').remove();

  const frameEl = document.querySelector('.plot-frame');
  const rect = frameEl.getBoundingClientRect();
  const W = Math.max(640, rect.width);
  const H = 560;

  svg.attr('viewBox', `0 0 ${W} ${H}`).attr('width', W).attr('height', H);

  const margin = { top: 32, right: 36, bottom: 60, left: 72 };
  const iw = W - margin.left - margin.right;
  const ih = H - margin.top - margin.bottom;

  // Gradient for pareto area
  const defs = svg.append('defs');
  const grad = defs.append('linearGradient').attr('id', 'paretoGradient').attr('x1', 0).attr('y1', 0).attr('x2', 0).attr('y2', 1);
  grad.append('stop').attr('offset', '0%').attr('stop-color', '#ffb454').attr('stop-opacity', 0.25);
  grad.append('stop').attr('offset', '100%').attr('stop-color', '#ffb454').attr('stop-opacity', 0);

  // Scales
  let xScale;
  const xVals = points.map(p => p.x);
  if (state.xAxis === 'cost_bracket') {
    xScale = d3.scaleLinear().domain([0.5, 5.5]).range([0, iw]);
  } else {
    const [lo, hi] = d3.extent(xVals);
    const pad = (hi - lo) * 0.08 || 1;
    xScale = d3.scaleLinear().domain([lo - pad, hi + pad]).range([0, iw]).nice();
  }

  let yScale;
  const yVals = points.map(p => p.y);
  if (yVals.length === 0) {
    yScale = d3.scaleLinear().domain([0, 100]).range([ih, 0]);
  } else {
    const [lo, hi] = d3.extent(yVals);
    const pad = (hi - lo) * 0.12 || 1;
    yScale = d3.scaleLinear().domain([Math.max(0, lo - pad), hi + pad]).range([ih, 0]).nice();
  }

  const g = svg.append('g').attr('transform', `translate(${margin.left}, ${margin.top})`);

  // Grid
  g.append('g').attr('class', 'grid')
    .call(d3.axisLeft(yScale).tickSize(-iw).tickFormat('').ticks(6));

  g.append('g').attr('class', 'grid')
    .attr('transform', `translate(0, ${ih})`)
    .call(state.xAxis === 'cost_bracket'
      ? d3.axisBottom(xScale).tickValues([1, 2, 3, 4, 5]).tickSize(-ih).tickFormat('')
      : d3.axisBottom(xScale).tickSize(-ih).tickFormat('').ticks(6));

  // Axes
  const xAxisG = g.append('g').attr('class', 'axis x').attr('transform', `translate(0, ${ih})`);
  if (state.xAxis === 'cost_bracket') {
    xAxisG.call(d3.axisBottom(xScale).tickValues([1, 2, 3, 4, 5]).tickFormat(n => '$'.repeat(n)));
    // annotate with currency range below the dollar signs
    xAxisG.selectAll('.tick').each(function(d) {
      const label = bracketTickLabel('$'.repeat(d));
      const currencyText = label.split('  ').slice(1).join('  ');
      d3.select(this).append('text')
        .attr('y', 28)
        .attr('text-anchor', 'middle')
        .style('font-size', '10px')
        .style('fill', 'var(--fg-3)')
        .text(currencyText);
    });
  } else {
    xAxisG.call(d3.axisBottom(xScale).ticks(6).tickFormat(d => formatNumber(d)));
  }

  const yAxisG = g.append('g').attr('class', 'axis y');
  yAxisG.call(d3.axisLeft(yScale).ticks(6).tickFormat(d => formatNumber(d)));

  // Axis titles
  const xTitle = state.xAxis === 'cost_bracket'
    ? `Cost bracket · ${state.data.currencies[state.currency].code}`
    : AXIS_LABELS[state.xAxis];
  svg.append('text').attr('class', 'axis-title')
    .attr('text-anchor', 'middle')
    .attr('x', margin.left + iw / 2)
    .attr('y', H - 14)
    .text(`X  ·  ${xTitle}`);

  const yTitle = state.yAxis === 'benchmark'
    ? state.data.benchmarks.find(b => b.id === state.benchmark)?.display_name || 'metric'
    : AXIS_LABELS[state.yAxis];
  svg.append('text').attr('class', 'axis-title')
    .attr('text-anchor', 'middle')
    .attr('transform', `rotate(-90, 22, ${margin.top + ih / 2})`)
    .attr('x', 22)
    .attr('y', margin.top + ih / 2)
    .text(`Y  ·  ${yTitle}`);

  // Frame rectangle
  g.append('rect')
    .attr('width', iw)
    .attr('height', ih)
    .attr('fill', 'none')
    .attr('stroke', '#2a3749')
    .attr('stroke-width', 1);

  // Corner brackets on the plot frame (instrumentation feel)
  const brkLen = 10;
  const brkCorners = [
    [0, 0, 0, brkLen, brkLen, 0],
    [iw, 0, iw - brkLen, 0, iw, brkLen],
    [0, ih, 0, ih - brkLen, brkLen, ih],
    [iw, ih, iw - brkLen, ih, iw, ih - brkLen]
  ];
  brkCorners.forEach(([cx, cy, x1, y1, x2, y2]) => {
    g.append('line').attr('x1', cx).attr('y1', cy).attr('x2', x1).attr('y2', y1).attr('stroke', '#ffb454').attr('stroke-width', 1.5);
    g.append('line').attr('x1', cx).attr('y1', cy).attr('x2', x2).attr('y2', y2).attr('stroke', '#ffb454').attr('stroke-width', 1.5);
  });

  // Pareto area + line
  if (paretoPoints.length > 1) {
    const linePath = d3.line()
      .x(p => xScale(p.x))
      .y(p => yScale(p.y))
      .curve(d3.curveLinear);
    g.append('path')
      .datum(paretoPoints)
      .attr('class', 'pareto-line')
      .attr('d', linePath);

    // Subtle band showing "better" side
    const areaPoints = paretoPoints.slice();
    const yTop = yDir === 'max' ? yScale.range()[1] : yScale.range()[0];
    const xEnd = xDir === 'min' ? xScale.range()[0] : xScale.range()[1];
    const bandPath = d3.line().x(p => xScale(p.x)).y(p => yScale(p.y))(areaPoints);
    g.append('path')
      .attr('class', 'pareto-area')
      .attr('d', `${bandPath} L ${xScale(paretoPoints[paretoPoints.length - 1].x)} ${yTop} L ${xScale(paretoPoints[0].x)} ${yTop} Z`);
  }

  // Crosshair (hover)
  const xhair = g.append('g').style('display', 'none');
  xhair.append('line').attr('class', 'crosshair-line').attr('id', 'xhair-v').attr('y1', 0).attr('y2', ih);
  xhair.append('line').attr('class', 'crosshair-line').attr('id', 'xhair-h').attr('x1', 0).attr('x2', iw);

  // Dots
  const dotG = g.append('g').attr('class', 'dots');

  // For cost_bracket X, jitter dots horizontally a bit so same-bracket cards don't overlap
  function jitteredX(p) {
    if (state.xAxis !== 'cost_bracket') return xScale(p.x);
    // deterministic jitter by hashing gpu.id
    const h = p.gpu.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    const jitter = ((h % 80) / 80 - 0.5) * 0.6; // ±0.3 bracket units
    return xScale(p.x + jitter);
  }

  const tooltip = document.getElementById('tooltip');

  const dots = dotG.selectAll('.dot')
    .data(points, d => d.gpu.id)
    .join('circle')
    .attr('class', d => {
      const cls = ['dot'];
      if (paretoIds.has(d.gpu.id)) cls.push('pareto');
      if (state.selectedGpu && state.selectedGpu.id === d.gpu.id) cls.push('selected');
      return cls.join(' ');
    })
    .attr('cx', d => jitteredX(d))
    .attr('cy', d => yScale(d.y))
    .attr('r', d => paretoIds.has(d.gpu.id) ? 8 : 6)
    .attr('fill', d => d.confidence === 'estimated' ? 'none' : archColor(d.gpu))
    .attr('stroke', d => archColor(d.gpu))
    .attr('stroke-dasharray', d => d.confidence === 'estimated' ? '2,2' : null)
    .style('color', d => archColor(d.gpu))
    .on('mouseenter', function(ev, d) {
      xhair.style('display', '');
      xhair.select('#xhair-v').attr('x1', jitteredX(d)).attr('x2', jitteredX(d));
      xhair.select('#xhair-h').attr('y1', yScale(d.y)).attr('y2', yScale(d.y));

      const gpu = d.gpu;
      const benchName = state.data.benchmarks.find(b => b.id === state.benchmark)?.short_name;
      const benchVal = gpu.results?.[state.benchmark];
      tooltip.innerHTML = `
        <div class="tt-name">${gpu.display_name}</div>
        <div class="tt-arch" style="color:${archColor(gpu)}">${gpu.architecture.replace('_', ' ')} · ${gpu.class}</div>
        <dl class="tt-grid">
          <dt>VRAM</dt><dd class="amber">${gpu.vram_gb} GB</dd>
          <dt>Bandwidth</dt><dd>${gpu.memory.bandwidth_gb_s} GB/s</dd>
          <dt>CC</dt><dd>${gpu.cc.toFixed(1)}</dd>
          <dt>Tensor Cores</dt><dd>${gpu.tensor_cores.present ? 'gen ' + (gpu.tensor_cores.generation || '?') : '—'}</dd>
          <dt>Cost</dt><dd>${formatCostBracket(gpu.cost_bracket, state.currency)}</dd>
          ${benchVal ? `<dt>${benchName}</dt><dd class="amber">${formatNumber(benchVal.value)} ${state.data.benchmarks.find(b => b.id === state.benchmark).metric_units}</dd>` : ''}
        </dl>
        <span class="tt-tag ${d.confidence}">${CONFIDENCE_LABELS[d.confidence]}</span>
        ${paretoIds.has(gpu.id) ? '<span class="tt-tag estimated" style="margin-left: 6px; background: var(--amber-glow); color: var(--amber);">⭐ PARETO</span>' : ''}
      `;
      positionTooltip(ev);
      tooltip.classList.add('visible');
    })
    .on('mousemove', function(ev) {
      positionTooltip(ev);
    })
    .on('mouseleave', function() {
      tooltip.classList.remove('visible');
      xhair.style('display', 'none');
    })
    .on('click', function(ev, d) {
      state.selectedGpu = d.gpu;
      renderDetail();
      render();
      const detail = document.getElementById('detail');
      detail.classList.add('visible');
      detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

  function positionTooltip(ev) {
    const r = frameEl.getBoundingClientRect();
    const offsetX = ev.clientX - r.left;
    const offsetY = ev.clientY - r.top;
    const tw = tooltip.offsetWidth;
    const th = tooltip.offsetHeight;
    let x = offsetX + 14;
    let y = offsetY + 14;
    if (x + tw > r.width - 8) x = offsetX - tw - 14;
    if (y + th > r.height - 8) y = offsetY - th - 14;
    tooltip.style.left = `${x}px`;
    tooltip.style.top = `${y}px`;
  }
}

function formatNumber(n) {
  if (n == null) return '—';
  if (!Number.isFinite(n)) return '—';
  if (Number.isInteger(n)) return n.toString();
  if (Math.abs(n) >= 100) return n.toFixed(0);
  if (Math.abs(n) >= 10) return n.toFixed(1);
  return n.toFixed(2);
}

// ====================================================================
// DETAIL PANEL
// ====================================================================

function renderDetail() {
  const gpu = state.selectedGpu;
  if (!gpu) return;

  document.getElementById('detail-title').textContent = gpu.display_name;
  document.getElementById('detail-meta').textContent = `${gpu.architecture.replace('_', ' ')} · ${gpu.class} · released ${gpu.release_year}`;

  const specsHTML = `
    <dt>VRAM</dt><dd class="amber">${gpu.vram_gb} GB ${gpu.memory.type.toUpperCase()}</dd>
    <dt>Bandwidth</dt><dd class="amber">${gpu.memory.bandwidth_gb_s} GB/s</dd>
    <dt>Memory bus</dt><dd>${gpu.memory.bus_bits}-bit</dd>
    <dt>Compute capability</dt><dd>${gpu.cc.toFixed(1)}</dd>
    <dt>Tensor Cores</dt><dd>${gpu.tensor_cores.present ? 'present · gen ' + (gpu.tensor_cores.generation || '?') : 'absent'}</dd>
    <dt>Power draw</dt><dd>${gpu.power_draw_w} W</dd>
    <dt>Form factor</dt><dd>${gpu.form_factor.replace('_', ' ')}</dd>
    <dt>Cost bracket</dt><dd class="amber">${formatCostBracket(gpu.cost_bracket, state.currency)}</dd>
    <dt>Release year</dt><dd>${gpu.release_year}</dd>
    <dt>Class</dt><dd>${gpu.class}</dd>
    <dt>Status</dt><dd>${gpu.status}</dd>
  `;
  document.getElementById('detail-specs-list').innerHTML = specsHTML;

  const tbody = document.querySelector('#detail-results-table tbody');
  tbody.innerHTML = '';
  state.data.benchmarks.forEach(b => {
    const r = gpu.results?.[b.id];
    const tr = document.createElement('tr');
    const hasValue = r && r.value != null;
    tr.innerHTML = `
      <td>${b.short_name}</td>
      <td>${r ? `<span class="tt-tag ${r.confidence}" style="display:inline-block">${CONFIDENCE_LABELS[r.confidence]}</span>` : '<span class="tt-tag" style="color: var(--fg-4); border-color: var(--border)">N/A</span>'}</td>
      <td class="value ${hasValue ? r.confidence : 'na'}">${hasValue ? `${formatNumber(r.value)} <span style="color: var(--fg-3); font-size: 11px">${b.metric_units}</span>` : '—'}</td>
    `;
    tbody.appendChild(tr);
  });

  const notesEl = document.getElementById('detail-notes');
  notesEl.textContent = gpu.notes || 'No notes yet.';
}
</script>

</body>
</html>
