{
  "name": "locobench-docs",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "clean": "rm -rf dist .astro node_modules/.astro",
    "build": "find src/content -name '._*' -delete || true; astro build",
    "rebuild": "npm run clean && npm run build",
    "preview": "astro preview",
    "validate:results": "node scripts/validate-results.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.34",
    "@locolabo/theme": "github:michael-borck/loco-theme#v0.2.4",
    "astro": "^5.7",
    "d3": "^7.9.2",
    "sharp": "^0.33"
  },
  "overrides": {
    "zod": "3.25.76",
    "@astrojs/sitemap": "3.7.0"
  }
}
